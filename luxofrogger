
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Molesworth Maze: The Great Escape</title>
    <style>
        body {
            margin: 0;
            background-color: #1a1a1a;
            color: white;
            font-family: 'Arial', sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            overflow: hidden;
        }
        h1 {
            margin: 5px 0;
            font-size: 24px;
            text-align: center;
            color: #ffcc00;
        }
        p {
            margin: 5px 0 15px 0;
            font-size: 14px;
            color: #cccccc;
            text-align: center;
            max-width: 500px;
        }
        #gameContainer {
            position: relative;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            border-radius: 8px;
            overflow: hidden;
        }
        canvas {
            background-color: #333;
            display: block;
        }
        #uiOverlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: rgba(0,0,0,0.8);
            transition: opacity 0.3s ease;
        }
        .btn {
            background-color: #00529b;
            color: white;
            border: none;
            padding: 12px 30px;
            font-size: 18px;
            font-weight: bold;
            border-radius: 5px;
            cursor: pointer;
            margin-top: 15px;
            box-shadow: 0 4px 0 #003366;
        }
        .btn:hover { background-color: #0066cc; }
        .btn:active { transform: translateY(4px); box-shadow: none; }
        #scoreBoard {
            display: flex;
            justify-content: space-between;
            width: 500px;
            margin-bottom: 5px;
            font-weight: bold;
            font-size: 16px;
        }
        .hidden { display: none !important; }
    </style>
</head>
<body>

    <h1>Molesworth Maze: The Great Escape</h1>
    <p>Help PM Chris Luxon navigate the "very difficult" Molesworth Street layout to safely reach the Parliamentary Precinct! Avoid speeding cyclists and marching protestors.</p>

    <div id= "scoreBoard">
        <div id="livesDisplay">LIVES: ❤️ ❤️ ❤️</div>
        <div id="statusDisplay">STATUS: In Transit</div>
    </div>

    <div id="gameContainer">
        <canvas id="gameCanvas" width="500" height="600"></canvas>
        <div id="uiOverlay">
            <h2 id="overlayTitle" style="color: #ffcc00; font-size: 28px; margin: 0;">PREPARE TO CROSS</h2>
            <p id="overlayText" style="margin: 10px 0;">Use ARROW KEYS or WASD to move.</p>
            <button id="startBtn" class="btn">START MISSION</button>
        </div>
    </div>

    <script>
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        
        // UI Elements
        const uiOverlay = document.getElementById('uiOverlay');
        const overlayTitle = document.getElementById('overlayTitle');
        const overlayText = document.getElementById('overlayText');
        const startBtn = document.getElementById('startBtn');
        const livesDisplay = document.getElementById('livesDisplay');
        const statusDisplay = document.getElementById('statusDisplay');

        // Game State
        let gameRunning = false;
        let lives = 3;
        let animationFrameId;

        // Map Layout Definition (Y coordinates)
        const ROW_HEIGHT = 50;
        const map = {
            parliament: { yStart: 0, yEnd: 100, color: '#e4f0ec' }, // Goal zone
            cycleLane2: { yStart: 100, yEnd: 150, color: '#008751' }, // Top Cycle lane
            trafficLane2: { yStart: 150, yEnd: 250, color: '#4a4a4a' }, // Protest lane 2
            trafficLane1: { yStart: 250, yEnd: 350, color: '#555555' }, // Protest lane 1
            cycleLane1: { yStart: 350, yEnd: 400, color: '#008751' }, // Bottom Cycle lane
            apartment: { yStart: 400, yEnd: 600, color: '#00529b' } // Safe start zone
        };

        // Player (Chris Luxon Caricature)
        const player = {
            x: 235,
            y: 520,
            width: 30,
            height: 45,
            speed: 12,
            reset: function() {
                this.x = 235;
                this.y = 520;
            }
        };

        // Obstacle classes
        class Cyclist {
            constructor(y, speed, direction) {
                this.y = y + 10;
                this.speed = speed;
                this.direction = direction; // 1 = right, -1 = left
                this.width = 25;
                this.height = 30;
                this.x = direction === 1 ? -40 : canvas.width + 40;
                this.color = '#ff3333';
            }
            update() {
                this.x += this.speed * this.direction;
            }
            draw() {
                ctx.fillStyle = this.color;
                // Simple bicycle/helmet shape
                ctx.fillRect(this.x, this.y, this.width, this.height);
                ctx.fillStyle = '#000';
                ctx.fillRect(this.x + (this.direction === 1 ? 15 : 2), this.y - 5, 8, 8); // Helmet
            }
        }

        class Protestor {
            constructor(y, speed, direction, slogan) {
                this.y = y + 5;
                this.speed = speed;
                this.direction = direction;
                this.slogan = slogan;
                this.width = 30;
                this.height = 40;
                this.x = direction === 1 ? -50 : canvas.width + 50;
            }
            update() {
                this.x += this.speed * this.direction;
            }
            draw() {
                // Draw Protestor body
                ctx.fillStyle = '#cc6600';
                ctx.fillRect(this.x, this.y + 15, this.width, this.height - 15);
                ctx.fillStyle = '#ffcc99'; // Head
                ctx.beginPath();
                ctx.arc(this.x + 15, this.y + 10, 8, 0, Math.PI * 2);
                ctx.fill();

                // Draw Placard/Sign
                ctx.fillStyle = '#ffffff';
                ctx.strokeStyle = '#000000';
                ctx.lineWidth = 1;
                const signX = this.x - 10;
                const signY = this.y - 20;
                ctx.fillRect(signX, signY, 50, 18);
                ctx.strokeRect(signX, signY, 50, 18);
                
                // Sign stick
                ctx.fillStyle = '#663300';
                ctx.fillRect(this.x + 14, signY + 18, 3, 15);

                // Text on Sign
                ctx.fillStyle = '#000000';
                ctx.font = 'bold 8px Arial';
                ctx.textAlign = 'center';
                ctx.fillText(this.slogan, signX + 25, signY + 12);
            }
        }

        let obstacles = [];
        const slogans = ["FIX THE ROADS", "SAVE OUR CITY", "NO CUTS", "MORE BUSES", "BIKE POWER"];

        function spawnObstacles() {
            if (!gameRunning) return;

            // Spawn Cyclists in Lane 1 (Bottom)
            if (Math.random() < 0.02) {
                obstacles.push(new Cyclist(map.cycleLane1.yStart, 3.5, 1));
            }
            // Spawn Cyclists in Lane 2 (Top)
            if (Math.random() < 0.02) {
                obstacles.push(new Cyclist(map.cycleLane2.yStart, 4, -1));
            }
            // Spawn Protestors in Traffic Lane 1
            if (Math.random() < 0.015) {
                let slogan = slogans[Math.floor(Math.random() * slogans.length)];
                obstacles.push(new Protestor(map.trafficLane1.yStart, 1.8, -1, slogan));
            }
            // Spawn Protestors in Traffic Lane 2
            if (Math.random() < 0.015) {
                let slogan = slogans[Math.floor(Math.random() * slogans.length)];
                obstacles.push(new Protestor(map.trafficLane2.yStart, 2.2, 1, slogan));
            }
        }

        // Draw Environment Elements
        function drawBackground() {
            // Draw Apartment Zone (Start)
            ctx.fillStyle = map.apartment.color;
            ctx.fillRect(0, map.apartment.yStart, canvas.width, 200);
            
            // Draw Cycle Lane 1
            ctx.fillStyle = map.cycleLane1.color;
            ctx.fillRect(0, map.cycleLane1.yStart, canvas.width, ROW_HEIGHT);
            drawCycleMarkings(map.cycleLane1.yStart);

            // Draw Traffic Lanes
            ctx.fillStyle = map.trafficLane1.color;
            ctx.fillRect(0, map.trafficLane1.yStart, canvas.width, ROW_HEIGHT);
            ctx.fillStyle = map.trafficLane2.color;
            ctx.fillRect(0, map.trafficLane2.yStart, canvas.width, ROW_HEIGHT);
            
            // Central road line
            ctx.strokeStyle = '#ffffff';
            ctx.setLineDash([15, 15]);
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.moveTo(0, 250);
            ctx.lineTo(canvas.width, 250);
            ctx.stroke();
            ctx.setLineDash([]); // Reset dash

            // Draw Cycle Lane 2
            ctx.fillStyle = map.cycleLane2.color;
            ctx.fillRect(0, map.cycleLane2.yStart, canvas.width, ROW_HEIGHT);
            drawCycleMarkings(map.cycleLane2.yStart);

            // Draw Parliament Precinct (Goal)
            ctx.fillStyle = map.parliament.color;
            ctx.fillRect(0, 0, canvas.width, map.parliament.yEnd);
            
            // Draw The Beehive / Gates Architectural Concept
            ctx.fillStyle = '#7f8c8d';
            ctx.fillRect(180, 20, 140, 60); // Main building shape
            ctx.fillStyle = '#bdc3c7';
ctx.fillRect(200, 10, 100, 15);
ctx.fillStyle = '#000'; // Gates entry
ctx.fillRect(230, 60, 40, 20);
}
function drawCycleMarkings(y) {
ctx.fillStyle = '#ffffff';
ctx.font = '10px Arial';
ctx.textAlign = 'center';
for (let x = 40; x < canvas.width; x += 120) {
ctx.fillText("🚲 ONLY", x, y + 30);
}
}
// Custom Vector Caricature of PM Chris Luxon
function drawPlayer() {
const cx = player.x + player.width / 2;
const cy = player.y + player.height / 2;
// 1. Sharp Blue Business Suit Body
ctx.fillStyle = '#002f6c';
ctx.beginPath();
ctx.moveTo(player.x, player.y + player.height);
ctx.lineTo(player.x + 5, player.y + 20);
ctx.lineTo(player.x + player.width - 5, player.y + 20);
ctx.lineTo(player.x + player.width, player.y + player.height);
ctx.closePath();
ctx.fill();
// White collar & Sky Blue Tie
ctx.fillStyle = '#ffffff';
ctx.beginPath();
ctx.moveTo(cx - 5, player.y + 20);
ctx.lineTo(cx, player.y + 27);
ctx.lineTo(cx + 5, player.y + 20);
ctx.fill();
ctx.fillStyle = '#0099ff'; // Tie
ctx.fillRect(cx - 2, player.y + 26, 4, 12);
// 2. Head (Caricature: Distinctly Bald and Glossy Head)
ctx.fillStyle = '#ffd1a9';
ctx.beginPath();
ctx.arc(cx, player.x + 18, 11, 0, Math.PI * 2); // Broad head circle
ctx.fill();
// Head gloss effect to accentuate bald feature
ctx.fillStyle = 'rgba(255, 255, 255, 0.4)';
ctx.beginPath();
ctx.arc(cx - 3, player.x + 13, 4, 0, Math.PI * 2);
ctx.fill();
// 3. Exaggerated Wide Broad Smile / Teeth
ctx.fillStyle = '#ffffff';
ctx.fillRect(cx - 6, player.y + 13, 12, 4);
ctx.strokeStyle = '#333';
ctx.lineWidth = 0.5;
ctx.strokeRect(cx - 6, player.y + 13, 12, 4);
// Eyes
ctx.fillStyle = '#333';
ctx.beginPath();
ctx.arc(cx - 4, player.y + 7, 1.5, 0, Math.PI * 2);
ctx.arc(cx + 4, player.y + 7, 1.5, 0, Math.PI * 2);
ctx.fill();
}
// Input Management
const keys = {};
window.addEventListener('keydown', e => {
keys[e.key.toLowerCase()] = true;
if(["arrowup", "arrowdown", "arrowleft", "arrowright", " "].includes(e.key)) {
e.preventDefault(); // Prevent browser scrolling
}
});
window.addEventListener('keyup', e => keys[e.key.toLowerCase()] = false);
function handleInput() {
if (keys['arrowup'] || keys['w']) player.y -= player.speed;
if (keys['arrowdown'] || keys['s']) player.y += player.speed;
if (keys['arrowleft'] || keys['a']) player.x -= player.speed;
if (keys['arrowright'] || keys['d']) player.x += player.speed;
// Canvas boundaries
if (player.x < 0) player.x = 0;
if (player.x > canvas.width - player.width) player.x = canvas.width - player.width;
if (player.y > canvas.height - player.height) player.y = canvas.height - player.height;
}
// Collision Checker
function checkCollisions() {
// Check boundaries vs obstacles
for (let i = 0; i < obstacles.length; i++) {
let o = obstacles[i];
if (player.x < o.x + o.width &&
player.x + player.width > o.x &&
player.y < o.y + o.height &&
player.y + player.height > o.y) {
handleFailure();
return;
}
}
// Check Win Condition (Entering Parliament Gates)
if (player.y < map.parliament.yEnd - 15) {
if (player.x > 210 && player.x < 280) {
handleWin();
} else {
// Hit the security fence walls next to the gate
player.y = map.parliament.yEnd - 15;
statusDisplay.textContent = "STATUS: Find the entry gate!";
}
}
}
function handleFailure() {
lives--;
updateLivesUI();
player.reset();
obstacles = [];
statusDisplay.textContent = "STATUS: Blocked by Infrastructure!";
if (lives <= 0) {
endGame(false, "MISSION FAILED", "Wellington's layout won this round. Try again!");
}
}
function handleWin() {
endGame(true, "MISSION ACCOMPLISHED!", "You successfully bypassed the cycleways and entered Parliament!");
}
function updateLivesUI() {
let hearts = "";
for(let i=0; i<3; i++) {
hearts += i < lives ? "❤️ " : "🖤 ";
}
livesDisplay.textContent = LIVES: ${hearts};
}
function endGame(success, title, text) {
gameRunning = false;
cancelAnimationFrame(animationFrameId);
overlayTitle.textContent = title;
overlayTitle.style.color = success ? "#00efff" : "#ff3333";
overlayText.textContent = text;
startBtn.textContent = "TRY AGAIN";
uiOverlay.classList.remove('hidden');
}
// Core Game Loop
function gameLoop() {
ctx.clearRect(0, 0, canvas.width, canvas.height);
drawBackground();
handleInput();
spawnObstacles();
// Update and draw obstacles
for (let i = obstacles.length - 1; i >= 0; i--) {
obstacles[i].update();
obstacles[i].draw();
// Clean up off-screen objects
if (obstacles[i].x < -100 || obstacles[i].x > canvas.width + 100) {
obstacles.splice(i, 1);
}
}
drawPlayer();
checkCollisions();
if (gameRunning) {
animationFrameId = requestAnimationFrame(gameLoop);
}
}
// Start button trigger
startBtn.addEventListener('click', () => {
lives = 3;
updateLivesUI();
statusDisplay.textContent = "STATUS: In Transit";
player.reset();
obstacles = [];
uiOverlay.classList.add('hidden');
gameRunning = true;
gameLoop();
});
// Frame initialization
drawBackground();
